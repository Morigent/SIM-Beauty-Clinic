# Supabase — copy to .env and fill in.
# EXPO_PUBLIC_* values are inlined into the client bundle; the publishable key is
# designed to be public. The database password is server-side only (migrations),
# so it must NOT carry the EXPO_PUBLIC_ prefix.
EXPO_PUBLIC_API_URL_SUPABASE=
EXPO_PUBLIC_API_KEY_SUPABASE=
SUPABASE_DB_PASSWORD=

# Quote band (https://api-ninjas.com/api/quotes). Copy to .env.local and fill in.
EXPO_PUBLIC_API_NINJAS_KEY=
